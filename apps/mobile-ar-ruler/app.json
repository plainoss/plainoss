{
  "expo": {
    "name": "AR Ruler",
    "slug": "ar-ruler",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "plugins": [
      [
        "@reactvision/react-viro",
        {
          "android": {
            "xRMode": ["AR"]
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.plainoss.arruler",
      "infoPlist": {
        "NSCameraUsageDescription": "AR Ruler requires camera access to measure real-world distances."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0c"
      },
      "package": "app.plainoss.arruler",
      "permissions": ["CAMERA"]
    }
  }
}
