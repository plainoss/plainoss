{
  "expo": {
    "name": "AR Ruler",
    "slug": "ar-ruler",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.plainoss.arruler",
      "infoPlist": {
        "NSCameraUsageDescription": "AR Ruler uses your camera to measure real-world distances, areas, and angles."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0c"
      },
      "package": "app.plainoss.arruler",
      "permissions": ["CAMERA"]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "AR Ruler needs camera access to place 3D measurement points in real space."
        }
      ]
    ]
  }
}
