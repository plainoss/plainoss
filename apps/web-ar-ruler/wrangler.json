{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plainoss-ar-ruler",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "ar-ruler.plainoss.app",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
